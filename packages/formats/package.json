{
  "name": "@broadset/formats",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:strict": "npm run lint -- --no-cache --max-warnings 0",
    "typecheck": "tsc -b",
    "test": "vitest run --passWithNoTests",
    "quality": "npm run lint && npm run typecheck && npm run test",
    "quality:strict": "npm run lint:strict && npm run typecheck && npm run test",
    "validate:pdfa": "node scripts/validate-pdfa.mjs",
    "pptx:corpus:fetch": "node scripts/fetch-pptx-corpus.mjs",
    "pptx:oracle:generate": "python3 scripts/generate-python-pptx-oracle.py",
    "pptx:oracle:test": "BROADSET_REQUIRE_PYTHON_PPTX=1 vitest run --passWithNoTests pptx/python-pptx-oracle",
    "pptx:xsd:validate": "BROADSET_REQUIRE_OPENXML_VALIDATOR=1 vitest run --passWithNoTests pptx/openxml-xsd-validate",
    "pptx:libreoffice:verify": "BROADSET_REQUIRE_LIBREOFFICE=1 vitest run --passWithNoTests pptx/libreoffice-verify"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "@types/css-tree": "^2.3.11",
    "@types/culori": "^4.0.1",
    "@types/fontkit": "^2.0.9",
    "@types/pdfkit": "^0.17.6",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "jspdf": "^4.2.1",
    "pdfkit": "^0.18.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@broadset/model": "^0.1.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "ag-psd": "^30.1.0",
    "bidi-js": "^1.0.3",
    "css-tree": "^3.2.1",
    "culori": "^4.0.2",
    "dompurify": "^3.4.1",
    "fast-xml-parser": "^5.7.1",
    "fflate": "^0.8.2",
    "fontkit": "^2.0.4",
    "linebreak": "^1.1.0",
    "mediabunny": "^1.40.1",
    "microdiff": "^1.5.0",
    "modern-screenshot": "^4.6.8",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.296",
    "pizzip": "^3.2.0",
    "qrcode-generator": "^2.0.4",
    "svgpath": "^2.6.0",
    "transformation-matrix": "^3.1.0",
    "wawoff2": "^2.0.1",
    "xxhash-wasm": "^1.1.0"
  }
}
