{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "commitlint.config.cjs",
        "eslint.config.cjs",
        "jest.config.cjs",
        "test/jest.setup.js"
      ],
      "ignoreDependencies": [
        "husky",
        "@commitlint/cli",
        "@commitlint/config-conventional",
        "vite",
        "playwright",
        "type-coverage"
      ]
    },
    "packages/demo": {
      "entry": ["src/main.tsx", "src/index.css", "src/**/*.test.{ts,tsx}", "ct/**/*.ct.tsx", "vite.config.ts"],
      "project": ["src/**/*.{ts,tsx}"],
      "vite": false
    },
    "packages/ui": {
      "entry": ["src/index.ts", "src/**/*.test.{ts,tsx}", "ct/**/*.ct.tsx"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/editor": {
      "entry": ["src/index.ts", "src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/model": {
      "entry": ["src/index.ts", "src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/playback": {
      "entry": ["src/index.ts", "src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/renderer": {
      "entry": ["src/index.ts", "src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/formats": {
      "entry": ["src/index.ts", "src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  },
  "ignoreBinaries": ["actionlint", "gitleaks"],
  "ignore": [
    "**/vite.config.ts",
    "**/playwright-ct.config.ts",
    "**/jest.config.cjs",
    "**/playwright/index.ts",
    "**/playwright/index.html"
  ]
}
