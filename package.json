{
  "name": "broadset-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace scaffold for the Broadset rebuild",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @broadset/demo",
    "build": "npm run build -w @broadset/demo",
    "lint": "npm run lint -w @broadset/demo",
    "lint:strict": "npm run lint:strict -w @broadset/demo",
    "format": "npm run format -w @broadset/demo",
    "typecheck": "npm run typecheck -w @broadset/demo",
    "test": "npm run test -w @broadset/demo",
    "ct": "npm run ct -w @broadset/demo",
    "quality": "npm run quality -w @broadset/demo",
    "quality:strict": "npm run quality:strict -w @broadset/demo",
    "quality:all": "npm run quality --workspaces --if-present",
    "quality:all:strict": "npm run quality:strict --workspaces --if-present",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix --no-cache --max-warnings 0 --no-warn-ignored",
    "*.{ts,tsx,js,jsx,cjs,mjs,json,md,yml,yaml,css,html}": "prettier --config .prettierrc.json --ignore-path .prettierignore --write"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-react-jsx": "^7.28.6",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "babel-jest": "^30.3.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1"
  }
}
