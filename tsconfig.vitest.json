{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "noEmit": true,
    "erasableSyntaxOnly": false
  },
  "include": [
    "vitest.base.ts",
    "vitest.config.ts",
    "test/vitest.setup.ts",
    "packages/*/vitest.config.ts"
  ]
}
