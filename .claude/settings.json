{
  "permissions": {
    "allow": [
      "Bash(git commit -m ' *)",
      "Bash(npm run quality)",
      "Bash(npm run quality -w *)",
      "Bash(npm run quality:all)",
      "Bash(npm run quality:strict)",
      "Bash(npm run lint)",
      "Bash(npm run lint -w *)",
      "Bash(npm run lint:strict)",
      "Bash(npm run lint:dead)",
      "Bash(npm run lint:check)",
      "Bash(npm run test)",
      "Bash(npm run test -w *)",
      "Bash(npm run typecheck)",
      "Bash(npm run typecheck -w *)",
      "Bash(npm run gate:full)",
      "Bash(npm run prettier:check)",
      "Bash(npm run ct)",
      "Bash(npm run ct -w *)",
      "Bash(npm ls)",
      "Bash(npm ls *)",
      "Bash(npm view *)",
      "Bash(npm info *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npx vitest run *)",
      "Bash(npx tsc --noEmit *)",
      "Bash(npx tsc -b *)",
      "Bash(npx prettier --check *)",
      "Bash(npx knip)",
      "Bash(npx knip *)",
      "Bash(bash agents/hooks/quality-gate.sh)",
      "Bash(agents/hooks/quality-gate.sh)",
      "Bash(agents/hooks/quality-gate.sh *)",
      "mcp__chrome-devtools__take_snapshot",
      "Skill(ralph-loop:ralph-loop)",
      "Skill(ralph-loop:ralph-loop:*)",
      "Bash(npm run docs:check)",
      "Bash(npm run test:docs)",
      "Bash(npm run roadmap:check)",
      "Bash(npm run roadmap:frontier)",
      "Bash(npm run roadmap:seed-state)",
      "Bash(npm run test:roadmap)",
      "Bash(git worktree *)",
      "Bash(git fetch *)",
      "Bash(git pull --ff-only*)",
      "Bash(git push -u origin agent/*)",
      "Bash(git push origin agent/*)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh pr merge * --squash --delete-branch)",
      "Bash(gh pr review *)",
      "Bash(git revert *)",
      "Bash(git checkout main)",
      "Bash(npm ci)"
    ],
    "additionalDirectories": ["/tmp", "/private/tmp"],
    "deny": [
      "Bash(git push origin main*)",
      "Bash(git push -u origin main*)",
      "Bash(git push* --force*)",
      "Bash(git push* -f *)",
      "Bash(git push* --delete*)",
      "Bash(git push*:*)",
      "Bash(gh pr merge* --admin*)",
      "Bash(gh pr merge* --repo*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "agents/hooks/session-context.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "agents/hooks/gate-commit.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "agents/hooks/check-quality.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "agents/hooks/quality-gate.sh",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
